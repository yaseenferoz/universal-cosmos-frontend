# Local, sourced catalog is the default. No backend is required.
VITE_DATA_SOURCE=local
# Copy to .env.local and set VITE_DATA_SOURCE=http to use the running backend.
# Open the frontend at http://localhost:5173 to match the backend CORS origin.
VITE_API_BASE_URL=http://localhost:4000

# Set the public HTTPS site origin when building canonical URLs and the sitemap.
# SITE_URL=https://your-domain.example
# Optional Google Search Console URL-prefix HTML tag content value.
# GOOGLE_SITE_VERIFICATION=
